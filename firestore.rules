rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Fields the client is never allowed to supply or change
    function noPrivilegedFields() {
      return !(request.resource.data.keys().hasAny(['credits', 'role']));
    }

    // Design status/result fields are set only by Cloud Functions (Admin SDK)
    function noProtectedDesignFields() {
      return !(request.resource.data.keys().hasAny([
        'status', 'results', 'palette', 'recommendations', 'errorMessage'
      ]));
    }

    // ── /users/{userId} ───────────────────────────────────────────────────────
    // Schema: name, email, credits, role, createdAt
    match /users/{userId} {
      // Read own profile only
      allow get: if isOwner(userId);

      // Create own profile; client must not set credits or role
      allow create: if isOwner(userId)
                    && noPrivilegedFields()
                    && request.resource.data.email == request.auth.token.email;

      // Update own profile; client must not change credits or role
      allow update: if isOwner(userId)
                    && noPrivilegedFields();

      // Admins can read any user profile (e.g. support tooling)
      allow get: if isAdmin();

      // Deletion only via Admin SDK / Cloud Functions
      allow delete: if false;
    }

    // ── /designs/{designId} ───────────────────────────────────────────────────
    // Schema: ownerId, roomType, style, budgetRange, originalImagePath,
    //         status, results, palette, recommendations, errorMessage, createdAt
    match /designs/{designId} {
      // Read own designs only
      allow get, list: if isSignedIn()
                       && resource.data.ownerId == request.auth.uid;

      // Create: client sets ownerId to themselves; protected fields are blocked
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && noProtectedDesignFields();

      // Client may update only non-protected fields (e.g. style preference edits)
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && noProtectedDesignFields();

      // Users can delete only their own designs
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;

      // Admins have full read access
      allow get, list: if isAdmin();
    }

    // ── /catalog/{itemId} ─────────────────────────────────────────────────────
    // Schema: name, category, styles[], price, currency (PKR),
    //         dimensionsCm, colors[], modelPath, thumbPath, isActive
    match /catalog/{itemId} {
      // Any signed-in user can browse the catalogue
      allow get, list: if isSignedIn();

      // Only admins can create, update or delete catalogue items
      allow create, update, delete: if isAdmin();
    }

    // ── /rooms3d/{roomId} ─────────────────────────────────────────────────────
    // Schema: room template information (name, dimensions, previewPath, etc.)
    match /rooms3d/{roomId} {
      // Any signed-in user can read room templates
      allow get, list: if isSignedIn();

      // Only admins can manage room templates
      allow create, update, delete: if isAdmin();
    }

    // ── /scenes/{sceneId} ─────────────────────────────────────────────────────
    // Schema: ownerId, designId, furnitureLayout[], createdAt
    match /scenes/{sceneId} {
      // Users manage only their own saved scenes
      allow get, list: if isSignedIn()
                       && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;

      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
